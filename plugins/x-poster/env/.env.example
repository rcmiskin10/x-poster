# x-poster env template. Copy to a writable file you control (e.g. ./x-poster.env),
# fill in YOUR values, and pass it with --env-file. NEVER commit the filled-in file.
#
# Use your OWN X app credentials from https://developer.x.com (nothing here is shared).
# OAuth 2.0 user-context. Required scopes on the app:
#   tweet.read tweet.write users.read media.write offline.access
#   (media.write is required for image upload or /2/media/upload returns 403;
#    offline.access is required to receive a refresh token.)
#
# Mint X_REFRESH_TOKEN once by running x-auth.mjs (see README). It rotates on every
# post and is rewritten back to the file you point X_ENV_FILE at.

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# --- optional knobs (defaults shown) ---
# Writable env file the poster rewrites the rotated refresh token into.
# MUST be a file you own — do NOT point it at the plugin dir (read-only, wiped on update).
# X_ENV_FILE=./x-poster.env
# Localhost callback port for the one-time auth flow (must match the X app's callback URL).
# X_AUTH_PORT=8723
# Full redirect URI (defaults to http://127.0.0.1:${X_AUTH_PORT}/callback).
# X_REDIRECT_URI=http://127.0.0.1:8723/callback
